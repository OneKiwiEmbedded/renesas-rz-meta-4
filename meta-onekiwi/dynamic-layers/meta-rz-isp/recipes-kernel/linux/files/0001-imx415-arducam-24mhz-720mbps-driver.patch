From: quangdinhxuan <quangcoi186@gmail.com>
Subject: [PATCH] media: imx415: Arducam IMX415 module (24 MHz INCK, 720 Mbps)

Driver part of the OneKiwi SDK 6.0 Arducam patch (renesas-rz-meta-4
sdk60-imx415-arducam-adv-4gb, 0002-onekiwi-rzv2h-4gb-imx415-arducam.patch),
without the device tree hunks (the device tree is in meta-onekiwi).
Applies after the meta-rz-isp kernel patches.

- imx415.c: 24 MHz INCK clock params, 4-lane 720 Mbps 25 fps mode,
  write clk/mode registers at stream start, 200 ms before XCLR release
- rzg2l-csi2.c: force D-PHY 720 Mbps for 730..750 Mbps (4 lanes)
- rzg2l-dma.c: 400 ms waits in the CRU stop paths
- rzv2h-isp IMX415_drv.c: LANE_MBPS 720
---
diff --git a/drivers/media/i2c/imx415.c b/drivers/media/i2c/imx415.c
index 2e7212e09..42c18bf01 100644
--- a/drivers/media/i2c/imx415.c
+++ b/drivers/media/i2c/imx415.c
@@ -129,27 +129,42 @@ struct imx415_clk_params {
 /* INCK Settings - includes all lane rate and INCK dependent registers */
 static const struct imx415_clk_params imx415_clk_params[] = {
 	{
-		.lane_rate = 891000000,
-		.inck = 74250000,
-		.regs[0] = { IMX415_BCWAIT_TIME, 0x0FF },
-		.regs[1] = { IMX415_CPWAIT_TIME, 0x0B6 },
-		.regs[2] = { IMX415_SYS_MODE, 0x5 },
+		.lane_rate = 720000000,
+		.inck = 24000000,
+		.regs[0] = { IMX415_BCWAIT_TIME, 0x054 },
+		.regs[1] = { IMX415_CPWAIT_TIME, 0x03B },
+		.regs[2] = { IMX415_SYS_MODE, 0x9 },
 		.regs[3] = { IMX415_INCKSEL1, 0x00 },
-		.regs[4] = { IMX415_INCKSEL2, 0x28 },
-		.regs[5] = { IMX415_INCKSEL3, 0x0C0 },
-		.regs[6] = { IMX415_INCKSEL4, 0x0E0 },
-		.regs[7] = { IMX415_INCKSEL5, 0x28 },
+		.regs[4] = { IMX415_INCKSEL2, 0x23 },
+		.regs[5] = { IMX415_INCKSEL3, 0x0B4 },
+		.regs[6] = { IMX415_INCKSEL4, 0x0FC },
+		.regs[7] = { IMX415_INCKSEL5, 0x23 },
 		.regs[8] = { IMX415_INCKSEL6, 0x0 },
 		.regs[9] = { IMX415_INCKSEL7, 0x1 },
-		.regs[10] = { IMX415_TXCLKESC_FREQ, 0x1290 },
+		.regs[10] = { IMX415_TXCLKESC_FREQ, 0x0600 },
+	},
+	{
+		.lane_rate = 1440000000,
+		.inck = 24000000,
+		.regs[0] = { IMX415_BCWAIT_TIME, 0x054 },
+		.regs[1] = { IMX415_CPWAIT_TIME, 0x03B },
+		.regs[2] = { IMX415_SYS_MODE, 0x8 },
+		.regs[3] = { IMX415_INCKSEL1, 0x00 },
+		.regs[4] = { IMX415_INCKSEL2, 0x23 },
+		.regs[5] = { IMX415_INCKSEL3, 0x0B4 },
+		.regs[6] = { IMX415_INCKSEL4, 0x0FC },
+		.regs[7] = { IMX415_INCKSEL5, 0x23 },
+		.regs[8] = { IMX415_INCKSEL6, 0x1 },
+		.regs[9] = { IMX415_INCKSEL7, 0x0 },
+		.regs[10] = { IMX415_TXCLKESC_FREQ, 0x0600 },
 	},
 };
 
-/* all-pixel 4-lane 720 Mbps 15.74 Hz mode */
+/* all-pixel 4-lane 720 Mbps 25.00 Hz mode */
 static const struct imx415_reg imx415_mode_4_720[] = {
 	{ IMX415_VMAX, 0x08CA },
-	{ IMX415_HMAX, 0x07F0 },
-	{ IMX415_LANEMODE, IMX415_LANEMODE_4 }, /* CHECKME: was LANEMODE_2 */
+	{ IMX415_HMAX, 0x0500 },
+	{ IMX415_LANEMODE, IMX415_LANEMODE_4 },
 	{ IMX415_TCLKPOST, 0x006F },
 	{ IMX415_TCLKPREPARE, 0x002F },
 	{ IMX415_TCLKTRAIL, 0x002F },
@@ -237,13 +252,13 @@ struct imx415_mode {
 /* mode configs */
 static const struct imx415_mode supported_modes[] = {
 	{
-		.lane_rate = 891000000,
+		.lane_rate = 720000000,
 		.lanes = 4,
 		.hmax_pix = 4400,
-		.pixel_rate = 297000000,
+		.pixel_rate = 247500000,
 		.reg_list = {
-			.num_of_regs = ARRAY_SIZE(imx415_mode_4_891),
-			.regs = imx415_mode_4_891,
+			.num_of_regs = ARRAY_SIZE(imx415_mode_4_720),
+			.regs = imx415_mode_4_720,
 		},
 	},
 };
@@ -617,9 +632,59 @@ static int imx415_set_mode(struct imx415 *sensor, int mode)
 	return 0;
 }
 
+/*
+ * ONEKIWI FIX: clk_params->regs[] (INCK/PLL settings) and
+ * supported_modes[].reg_list (VMAX/HMAX/LANEMODE/D-PHY timing) were parsed
+ * in imx415_parse_hw_config() but never actually written to the sensor.
+ * Without this, the chip runs on its power-on-reset defaults, which happen
+ * to match the 74.25MHz INCK family and never match a 24MHz INCK config.
+ */
+static int imx415_write_regs(struct imx415 *sensor, const struct imx415_reg *regs,
+			     unsigned int num_regs)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < num_regs; i++) {
+		ret = imx415_write(sensor, regs[i].address, regs[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
 static int imx415_setup(struct imx415 *sensor, struct v4l2_subdev_state *state)
 {
-	return imx415_set_mode(sensor, sensor->cur_mode);
+	int ret;
+
+	ret = imx415_set_mode(sensor, sensor->cur_mode);
+	if (ret)
+		return ret;
+
+	dev_info(sensor->dev,
+		"ONEKIWI FIX ACTIVE: writing %d clk_params regs (lane_rate=%llu inck=%llu) + %d mode regs\n",
+		IMX415_NUM_CLK_PARAM_REGS, sensor->clk_params->lane_rate,
+		sensor->clk_params->inck,
+		supported_modes[sensor->cur_mode].reg_list.num_of_regs);
+
+	ret = imx415_write_regs(sensor, sensor->clk_params->regs,
+				IMX415_NUM_CLK_PARAM_REGS);
+	if (ret) {
+		dev_info(sensor->dev, "ONEKIWI FIX: clk_params write failed ret=%d\n", ret);
+		return ret;
+	}
+
+	ret = imx415_write_regs(sensor,
+				 supported_modes[sensor->cur_mode].reg_list.regs,
+				 supported_modes[sensor->cur_mode].reg_list.num_of_regs);
+	if (ret) {
+		dev_info(sensor->dev, "ONEKIWI FIX: mode reg_list write failed ret=%d\n", ret);
+		return ret;
+	}
+
+	dev_info(sensor->dev, "ONEKIWI FIX: all regs written OK\n");
+	return 0;
 }
 
 static int imx415_wakeup(struct imx415 *sensor)
@@ -871,6 +936,14 @@ static int imx415_power_on(struct imx415 *sensor)
 	if (ret < 0)
 		return ret;
 
+	/* 
+	 * ONEKIWI HACK: Datasheet page 84 requires XCLR to be Low during power on,
+	 * and specifies: "XCLR can be High after 200 ms or more from the time 
+	 * when all power supplies are finished." 
+	 * The original driver missed this completely and brought it High immediately.
+	 */
+	msleep(200);
+
 	gpiod_set_value_cansleep(sensor->reset, 0);
 
 	udelay(1);
diff --git a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c
index aa826f8ea..5f1764b9e 100644
--- a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c
+++ b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-csi2.c
@@ -446,6 +446,15 @@ static int rzg2l_csi2_calc_mbps(struct rzg2l_csi2 *priv, unsigned int bpp)
 	mbps = v4l2_ctrl_g_ctrl_int64(ctrl) * bpp;
 	do_div(mbps, priv->lanes * 1000000);
 
+	/* ONEKIWI HACK: Fix PHY mismatch for IMX415 (Arducam, 24 MHz INCK).
+	 * The driver calculates 742 Mbps based on 247.5M pixel_rate (at RAW12 25fps),
+	 * but the sensor's PLL actually outputs 720 Mbps.
+	 * We force it to 720 Mbps here so the D-PHY locks correctly,
+	 * without changing pixel_rate (which would crash the ISP daemon).
+	 */
+	if (mbps > 730 && mbps < 750 && priv->lanes == 4)
+		mbps = 720;
+
 	return mbps;
 }
 
diff --git a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-dma.c b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-dma.c
index de0fccd60..ca0681934 100644
--- a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-dma.c
+++ b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-dma.c
@@ -1060,7 +1060,7 @@ static void rzg2l_cru_stop(struct rzg2l_cru_dev *cru)
 		/* Wait for streaming to stop */
 		while (retries++ < 5) {
 			spin_unlock_irqrestore(&cru->qlock, flags);
-			msleep(100);
+			msleep(400); // ONEKIWI HACK: Arducam patch (was 100)
 			spin_lock_irqsave(&cru->qlock, flags);
 		}
 	}
@@ -1171,7 +1171,7 @@ static int retry_streaming_func(void *data)
 			if (cru->state == RUNNING)
 				goto retry_done;
 
-			msleep(20);
+			msleep(400); // ONEKIWI HACK: Arducam patch (was 20)
 		}
 
 		/* Stop CRU reception */
diff --git a/drivers/media/platform/renesas/rzv2h-isp/subdev/sensor/src/driver/sensor/IMX415_drv.c b/drivers/media/platform/renesas/rzv2h-isp/subdev/sensor/src/driver/sensor/IMX415_drv.c
index a8aa7c292..e779ad7fb 100644
--- a/drivers/media/platform/renesas/rzv2h-isp/subdev/sensor/src/driver/sensor/IMX415_drv.c
+++ b/drivers/media/platform/renesas/rzv2h-isp/subdev/sensor/src/driver/sensor/IMX415_drv.c
@@ -39,7 +39,9 @@
 #define DGAIN_PRECISION 8
 
 #define PIXEL_CLOCK 74250000
-#define LANE_MBPS 891
+/* ONEKIWI: Arducam IMX415 (24 MHz INCK) runs at 720 Mbps/lane (EVK module: 891).
+ * The CRU programs the CSI-2 D-PHY with this value when the ISP is used. */
+#define LANE_MBPS 720
 #ifdef CONFIG_VIDEO_RZG2L_CRU_EMBEDDED_DATA
 #define EMBEDDED_DATA_LINE 1
 #else
-- 
