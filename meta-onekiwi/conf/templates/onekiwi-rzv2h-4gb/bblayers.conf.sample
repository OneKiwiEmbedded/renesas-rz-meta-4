# POKY_BBLAYERS_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
POKY_BBLAYERS_CONF_VERSION = "2"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \
  ${TOPDIR}/../poky/meta \
  ${TOPDIR}/../poky/meta-poky \
  ${TOPDIR}/../poky/meta-yocto-bsp \
  ${TOPDIR}/../meta-openembedded/meta-oe \
  ${TOPDIR}/../meta-openembedded/meta-python \
  ${TOPDIR}/../meta-openembedded/meta-multimedia \
  ${TOPDIR}/../meta-arm/meta-arm-toolchain \
  ${TOPDIR}/../meta-arm/meta-arm \
  ${TOPDIR}/../meta-renesas/meta-rz-bsp \
  ${TOPDIR}/../meta-renesas/meta-rz-distro \
  ${TOPDIR}/../meta-renesas/meta-onekiwi \
  ${@'${TOPDIR}/../meta-qt5' if os.path.isdir('${TOPDIR}/../meta-qt5') else ''} \
  ${@'${TOPDIR}/../meta-rz-features/meta-rz-codecs' if os.path.isdir('${TOPDIR}/../meta-rz-features/meta-rz-codecs') else ''} \
  ${@'${TOPDIR}/../meta-rz-features/meta-rz-graphics' if os.path.isdir('${TOPDIR}/../meta-rz-features/meta-rz-graphics') else ''} \
  ${@'${TOPDIR}/../meta-rz-features/meta-rz-drpai' if os.path.isdir('${TOPDIR}/../meta-rz-features/meta-rz-drpai') else ''} \
  ${@'${TOPDIR}/../meta-rz-features/meta-rz-isp' if os.path.isdir('${TOPDIR}/../meta-rz-features/meta-rz-isp') else ''} \
  ${@'${TOPDIR}/../meta-rz-features/meta-rz-opencva' if os.path.isdir('${TOPDIR}/../meta-rz-features/meta-rz-opencva') else ''} \
  "
