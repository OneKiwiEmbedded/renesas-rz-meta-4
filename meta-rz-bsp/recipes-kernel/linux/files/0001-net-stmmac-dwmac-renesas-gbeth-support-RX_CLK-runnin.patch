From 04584cab1a4eb6d0d3f895f2c390aa5404a92995 Mon Sep 17 00:00:00 2001
From: hienhuynh <hien.huynh.px@renesas.com>
Date: Wed, 17 Dec 2025 15:00:16 +0700
Subject: [PATCH 1/2] net: stmmac: dwmac-renesas-gbeth: support RX_CLK running
 in LPI state

This commit adds "snps,en-tx-lpi-clockgating" property to ETH's nodes
to support TX clock gating in LPI state for RZ/V2N SoC.

Signed-off-by: Minh Nguyen <minh.nguyen.kx@renesas.com>
---
 drivers/net/ethernet/stmicro/stmmac/dwmac-renesas-gbeth.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-renesas-gbeth.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-renesas-gbeth.c
index d59daf4a7b7a..a50a2246afa5 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-renesas-gbeth.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-renesas-gbeth.c
@@ -182,6 +182,7 @@ static int renesas_gbeth_probe(struct platform_device *pdev)
 	plat_dat->set_clk_tx_rate = stmmac_set_clk_tx_rate;
 	plat_dat->init = renesas_gbeth_init;
 	plat_dat->exit = renesas_gbeth_exit;
+	plat_dat->rx_clk_runs_in_lpi = 1;
 
 	err = renesas_gbeth_init(pdev, plat_dat->bsp_priv);
 	if (err)
-- 
2.34.1

